.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Claude Code - ignore user-specific settings only
.claude/settings.local.json
.claude/worktrees/

# Documentation (generated/planning artifacts)
docs/


# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/**/.cxx
/android/**/build
/android/common/**/.**/
/android/common/local.*
/android/core/**/includes/
/android/core/**/cmake-build-*/
/android/core/**/jniLibs/

#FlClash
/libclash/
/android/app/src/main/jniLibs/
/services/helper/target
/macos/**/Package.resolved
/macos/build/
/env.json
/core_sha256.json
/plugins/rust_api/.claude/
/issue-triage/
devtools_options.yaml

# FVM Version Cache
.fvm/
.fvmrc
/coverage/lcov.info

# Local credential-bearing configuration. Keep these rules scoped to local
# files and known user-export names so committed source and test fixtures stay
# visible to Git.
/.env
/.env.*
!/.env.example
!/.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

/proxy.yaml
/proxy.yml
/proxy.json
/subscription.yaml
/subscription.yml
/subscription.json
/subscriptions.yaml
/subscriptions.yml
/subscriptions.json
/profile.yaml
/profile.yml
/profile.json
/profiles.yaml
/profiles.yml
/profiles.json
/credentials.yaml
/credentials.yml
/credentials.json
/secrets.yaml
/secrets.yml
/secrets.json
/client.ovpn
/profile.ovpn
**/*.local.yaml
**/*.local.yml
**/*.local.json
**/*.local.conf
**/*.local.ini
**/*.local.toml
**/*.local.ovpn
**/*.secret
**/*.secret.yaml
**/*.secret.yml
**/*.secret.json
**/*.credentials
**/*.credentials.yaml
**/*.credentials.yml
**/*.credentials.json

# Private key and keystore material. Public certificates (*.crt) are not
# ignored; the filename patterns below target private key conventions.
**/.ssh/id_rsa
**/.ssh/id_ed25519
**/.ssh/id_ecdsa
**/.ssh/id_dsa
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/id_dsa
**/private.pem
**/private_*.pem
**/private-*.pem
**/*_private.pem
**/*-private.pem
**/*_key.pem
**/*-key.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/*.jks

# This upstream test certificate key is intentionally tracked and is checked
# by the staged-content scanner if it is ever changed.
!core/Clash.Meta/test/config/example.org-key.pem
